---
interface Props {
	title: string;
}

import '../styles/global.css';

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">
		
		<title>{title}</title>
	</head>
	<body class="bg-cream text-dark-gray font-sans antialiased">
		<video
			class="fixed inset-0 z-0 h-full w-full scale-105 object-cover blur-md"
			autoplay
			loop
			muted
			playsinline
			aria-hidden="true"
		>
			<source src="/background.mp4" type="video/mp4" />
		</video>
		<div class="fixed inset-0 z-[1] bg-white/50" aria-hidden="true"></div>
		<div class="relative z-10">
			<slot />
		</div>
	</body>
</html>

<style is:global>
	body {
		background-color: #F3F2EE;
	}
</style>